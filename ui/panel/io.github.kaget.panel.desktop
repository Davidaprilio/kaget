[Desktop Entry]
Type=Application
Name=KAGeT Control Panel
GenericName=Touchpad Control Panel
Comment=Brightness, volume and keyboard backlight sliders on the touchpad
Exec=kaget-panel --toggle
Icon=view-media-equalizer
Terminal=false
Categories=Qt;KDE;Utility;
Keywords=touchpad;panel;brightness;volume;backlight;slider;kaget;
StartupNotify=false
X-KDE-Shortcuts=Meta+Alt+P
Actions=settings;

[Desktop Action settings]
Name=KAGeT Settings
Exec=kaget
Icon=input-touchpad
